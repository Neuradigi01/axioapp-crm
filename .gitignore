# OS
.DS_Store
Thumbs.db

# Storage (runtime file uploads). Anchored to the API root's upload dir
# (created by main.py as ./storage relative to the runtime CWD). A bare,
# unanchored `storage/` also matched the SOURCE package
# src/app/shared/storage/ and silently un-tracked it — it never got
# committed, never shipped in the image, and prod died with
# ModuleNotFoundError: 'src.app.shared.storage'. Keep these anchored.
/API/storage/
/api/storage/
/storage/

# Sidecar services (Node). node_modules/ is already ignored globally;
# dist/ and storage/ are anchored above, so name them explicitly per
# sidecar so the patterns also match sidecars/<name>/dist and
# sidecars/<name>/storage.
sidecars/*/node_modules/
sidecars/*/dist/
sidecars/*/storage/

# Docker volumes
postgres-data/
redis-data/

# Widget bundle. node_modules is always ignored. `dist/` contents are
# ignored EXCEPT `dist/v1/widget.js` — that gets committed so prod
# deploys don't need Node to build the widget (docker-compose mounts
# ../widget/dist into the API container at /app/widget). Source maps
# and any future files under dist/ stay ignored. The negations override
# the global `dist/` rule higher in this file.
widget/node_modules/
!widget/dist/
!widget/dist/v1/
widget/dist/*
!widget/dist/v1/
widget/dist/v1/*
!widget/dist/v1/widget.js

# Logs
logs/
*.log
