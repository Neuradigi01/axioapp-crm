# Port the sidecar listens on. FastAPI will call http://<host>:SIDECAR_PORT.
SIDECAR_PORT=4000

# 32+ byte secret used to verify HMAC on inbound requests from FastAPI.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIDECAR_HMAC_SECRET=replace-me-with-32-byte-hex

# Base URL of the FastAPI service. Used in later steps to forward events.
FASTAPI_BASE_URL=http://localhost:8000

# 32+ byte secret used to sign HMAC on outbound requests to FastAPI.
# Must match the value FastAPI verifies with. Generate the same way as above.
FASTAPI_HMAC_SECRET=replace-me-with-32-byte-hex

# pino log level: debug | info | warn | error
LOG_LEVEL=info

# Where Baileys session credentials are persisted (Step 2). Path is relative
# to the sidecar working directory unless absolute.
STORAGE_DIR=./storage
