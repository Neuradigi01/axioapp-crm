# ─────────────────────────────────────────────────────────────────
# PRODUCTION non-secret configuration. Loaded on top of config.env
# when .environment == prod. Secrets live in secrets.prod.enc.env
# (SOPS-encrypted, injected at runtime by run.cmd / run.sh).
#
# All values here are safe to commit — real secrets never live in
# any config.*.env file.
# ─────────────────────────────────────────────────────────────────

APP_ENV=prod
IS_DEVELOPMENT=false

# Reverse-proxy allow-list for X-Forwarded-For (CIDRs, comma-separated). nginx
# runs on the host, so requests reach the container from the `crm_default`
# network gateway. Required: the API refuses to boot in prod when empty.
TRUSTED_PROXIES=172.26.0.1/32

# Database — remote managed Postgres.
DB_HOST=145.223.21.204
DB_PORT=8975
DB_NAME=db_crm_template
DB_USER=postgres

# Frontend / API base URLs — public domains.
FRONTEND_URL=https://crm.aixoapp.com
API_BASE_URL=https://crm-api.aixoapp.com

# OAuth callbacks — public HTTPS. Same OAuth clients as local; both
# URLs are registered on each provider's console.
GOOGLE_OAUTH_REDIRECT_URI=https://crm-api.aixoapp.com/api/v1/integrations/google/callback
GOOGLE_GMAIL_REDIRECT_URI=https://crm-api.aixoapp.com/api/v1/email/gmail/callback
GOOGLE_CALENDAR_REDIRECT_URI=https://crm-api.aixoapp.com/api/v1/integrations/google-calendar/callback
META_OAUTH_REDIRECT_URI=https://crm-api.aixoapp.com/api/v1/integrations/meta/callback
MICROSOFT_GRAPH_REDIRECT_URI=https://crm-api.aixoapp.com/api/v1/integrations/microsoft/callback

# Mailgun inbound — verified reply subdomain (Step 8 cutover, 2026-09-02).
MAILGUN_DOMAIN=reply.karmcrm.com
INBOUND_EMAIL_DOMAIN=reply.karmcrm.com
MAILGUN_WEBHOOK_URL=https://crm-api.aixoapp.com/api/v1/webhooks/mailgun/inbound

# tasks/email-sending-domains Step 6 — DNS-drift state-machine
# thresholds for tbl_organization_email_domains.
EMAIL_DOMAIN_DEMOTE_AFTER_FAILED_CHECKS=3
EMAIL_DOMAIN_RELEASE_AFTER_FAILED_DAYS=14

# Microsoft Graph subscription webhook — public HTTPS URL Graph POSTs
# change notifications to. Enables push sync (~seconds) instead of the
# 60-second poll fallback.
MICROSOFT_GRAPH_WEBHOOK_URL=https://crm-api.aixoapp.com/api/v1/email/microsoft/webhook

# Meta App — the deployed customer's OWN Meta app (BYO pattern until
# Embedded Signup ships on the central app). Meta signs inbound
# WhatsApp webhooks with this app's App Secret, so the signature
# verifier in prod must be configured with the SAME app's secret
# (WHATSAPP_APP_SECRET + META_APP_SECRET in secrets.prod.enc.env).
# When prod eventually onboards a second customer with their own
# Meta app, this single-value env stops working and either Embedded
# Signup (all customers under one central app) or per-org
# app_secret_enc (flip precedence in conversations/router.py) is
# required.
META_APP_ID=1082418781395860

# Sentry — AIXO client deployment reports to AIXO's own Sentry account
# (project `aixoapp-backend`), overriding the main Neuradigi DSN from
# config.env. DSN is a write-only token — safe to commit. 10% tracing so
# the quota lasts.
SENTRY_DSN=https://d3b0342755567ec089fa3f045b431060@o4512164209164288.ingest.us.sentry.io/4512164227186688
SENTRY_ENVIRONMENT=production-aixoapp
SENTRY_TRACES_SAMPLE_RATE=0.1
