# Project
COMPOSE_PROJECT_NAME=template_api
APP_NAME=Template App
IS_DEVELOPMENT=true

# Docker Compose
API_PORT=8000
LISTEN_ADDR=127.0.0.1
FLOWER_PORT=5555
FLOWER_USER=admin
FLOWER_PASS=admin

# Captcha — "none" | "image" | "recaptcha_v2" | "recaptcha_v3"
CAPTCHA_TYPE=none
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

IPINFO_TOKEN=your_ipinfo_token

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_template_new
DB_USER=postgres
DB_PASSWORD=your_db_password

# JWT & Security
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
FERNET_KEY=your-fernet-secret-key-change-this!

# OTP
OTP_EXPIRY_MINUTES=10

# Email (SMTP)
EMAIL_ENABLED=false
EMAIL_SENDER=noreply@example.com
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password
EMAIL_APP_PASSWORD=your_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Contact Verification — "none" | "pre" | "post"
CONTACT_VERIFICATION_MODE=none

# SMS
SMS_ENABLED=false
SMS_API_URL=https://api.sms-provider.com/send
SMS_API_KEY=your_sms_api_key

# Redis / Celery
CELERY_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB_BROKER=0
REDIS_DB_RESULT=1

# Push Notifications (Firebase)
PUSH_NOTIFICATION_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=

# Frontend URL (used in password reset emails)
FRONTEND_URL=http://localhost:4200

# Routes (API-internal cache)
ROUTES_API=data/routes.json

# Time
DATETIME_FORMAT=%d-%b-%Y %I:%M:%S %p
TIMEZONE=Asia/Kolkata

# Static / Uploads
STATIC_DIR=./static
MAX_FILE_SIZE_MB=10
MAX_ATTACHMENTS_PER_MESSAGE=5

# ─────────────────────────────────────────────────────────────────
# FurnitureCRM — forward-looking vars (filled in their respective phases)
# ─────────────────────────────────────────────────────────────────

# File storage abstraction (Step 4.7)
STORAGE_BACKEND=local
STORAGE_ROOT=./storage

# WhatsApp Business Cloud API — credentials are stored per-org in the
# `integrations` + `whatsapp_account_configs` tables (Step 3.5.1). Each
# org connects via Settings → Integrations → WhatsApp; no env config.

# AI / LLM — Conversations chatbot + auto follow-ups (Step 5.7, 5.8)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# Marketplace integrations (Steps 5.2 / 5.3 / 5.4)
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
FLIPKART_CLIENT_ID=
FLIPKART_CLIENT_SECRET=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# AI Virtual Staging — Replicate / Stability (Step 5.9)
STAGING_PROVIDER=replicate
REPLICATE_API_TOKEN=

# ─────────────────────────────────────────────────────────────────
# Ad integrations (Google Ads + Meta Ads) — Track 4
# ─────────────────────────────────────────────────────────────────

# Fernet key for at-rest encryption of stored OAuth tokens.
# Generate with:
#   docker exec template_api-api-1 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED — `core/integrations/*` refuses to import without it.
# Losing the key = every org must reconnect Google + Meta.
INTEGRATIONS_ENCRYPTION_KEY=

# Google Ads OAuth (Track 4 Step 2)
# Provision from Google Cloud Console — see
# tasks/ad-integrations/manual-google-oauth-setup.md
# Test users bypass verification; the code works in dev without
# the verification process being complete.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# Gmail OAuth — reuses the same OAuth client (id/secret above) but
# with a different redirect URI for the per-rep mailbox connect flow.
# Register this URI on the same Google Cloud OAuth client alongside
# the Ads URI. Track: tasks/app-updates/email/.
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/email/gmail/callback
# Gmail push notifications (OPTIONAL). When set, the connect flow
# registers a Pub/Sub watch and incoming pushes hit
# /api/v1/email/gmail/push. When unset, the mailbox is synced via
# Step 4's 60-second poll fallback.
# Format: projects/<gcp-project>/topics/<topic-name>
GOOGLE_GMAIL_PUBSUB_TOPIC=
# Email of the Pub/Sub-push service account configured to invoke our
# webhook. Required when GOOGLE_GMAIL_PUBSUB_TOPIC is set — the push
# handler rejects JWTs not signed by this identity.
GOOGLE_GMAIL_PUBSUB_SA_EMAIL=
# Per-account daily send caps (OPTIONAL overrides). Defaults: 200/500.
# EMAIL_DAILY_SOFT_CAP=200
# EMAIL_DAILY_HARD_CAP=500

# Microsoft 365 / Outlook OAuth (Track app-updates/email Step 3).
# Provision from an Azure App Registration:
#   1. portal.azure.com → App registrations → New registration.
#   2. Account types: "Multitenant + personal Microsoft accounts".
#   3. Redirect URI: Web →
#      http://localhost:8000/api/v1/email/microsoft/callback
#   4. Certificates & secrets → New client secret → copy the VALUE.
#   5. API permissions → Microsoft Graph (delegated): Mail.ReadWrite,
#      Mail.Send, offline_access, User.Read. Grant admin consent on
#      your test tenant.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# `common` = any work/school/personal account; for single-tenant
# production override to the tenant GUID.
MICROSOFT_TENANT=common
MICROSOFT_GRAPH_REDIRECT_URI=http://localhost:8000/api/v1/email/microsoft/callback
# Public HTTPS URL Graph will POST change notifications to. Must
# be reachable from the internet. For dev, tunnel via ngrok and set
# this to the public ngrok URL + /api/v1/email/microsoft/webhook.
# Leave empty to disable subscriptions; sync falls back to Step 4
# poll.
MICROSOFT_GRAPH_WEBHOOK_URL=

# Developer Token — separate from OAuth, attached to a Google Ads
# Manager (MCC) account. 1-5 day approval. See Stage 4 of the checklist.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Google Ads REST API version pin. Bumping is a separate small task.
GOOGLE_ADS_API_VERSION=v17

# Meta (Facebook + Instagram) Ads OAuth (Track 4 Step 4)
# Provision from a Meta app at developers.facebook.com — see
# tasks/ad-integrations/manual-meta-oauth-setup.md.
# Test users bypass App Review for `leads_retrieval` in dev mode;
# production needs 1-2 weeks of Meta App Review.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/meta/callback
# Random secret SHARED with the Meta app's Webhooks tab — used during
# the GET-time subscription handshake (Step 5). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# and paste the SAME value into both .env AND the Meta app dashboard.
META_WEBHOOK_VERIFY_TOKEN=
# Graph API version pin. Bumping is a separate small task.
META_GRAPH_API_VERSION=v19.0

# Stripe (Track 4 Pricing & Billing, Step 11)
# Test keys from https://dashboard.stripe.com/test/apikeys (sk_test_…, pk_test_…)
# Webhook signing secret from https://dashboard.stripe.com/test/webhooks after
# registering the FurnitureCRM webhook endpoint (whsec_…).
# Before first Checkout works, run the seed script once to populate
# `app/core/subscriptions/stripe_price_map.yaml`:
#   docker exec template_api-api-1 python -m app.scripts.seed_stripe_catalog
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=



