# Project
COMPOSE_PROJECT_NAME=template_api
APP_NAME=Template App
IS_DEVELOPMENT=true

# Docker Compose
API_PORT=8000
LISTEN_ADDR=127.0.0.1
FLOWER_PORT=5555
FLOWER_USER=admin
FLOWER_PASS=admin

# Captcha — "none" | "image" | "recaptcha_v2" | "recaptcha_v3"
CAPTCHA_TYPE=none
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

IPINFO_TOKEN=your_ipinfo_token

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_template_new
DB_USER=postgres
DB_PASSWORD=your_db_password

# JWT & Security
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
FERNET_KEY=your-fernet-secret-key-change-this!

# OTP
OTP_EXPIRY_MINUTES=10

# Email (SMTP)
EMAIL_ENABLED=false
EMAIL_SENDER=noreply@example.com
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password
EMAIL_APP_PASSWORD=your_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Contact Verification — "none" | "pre" | "post"
CONTACT_VERIFICATION_MODE=none

# SMS
SMS_ENABLED=false
SMS_API_URL=https://api.sms-provider.com/send
SMS_API_KEY=your_sms_api_key

# Redis / Celery
CELERY_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB_BROKER=0
REDIS_DB_RESULT=1

# Push Notifications (Firebase)
PUSH_NOTIFICATION_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=

# Frontend URL (used in password reset emails)
FRONTEND_URL=http://localhost:4200

# Routes (API-internal cache)
ROUTES_API=data/routes.json

# Time
DATETIME_FORMAT=%d-%b-%Y %I:%M:%S %p
TIMEZONE=Asia/Kolkata

# Static / Uploads
STATIC_DIR=./static
MAX_FILE_SIZE_MB=10
MAX_ATTACHMENTS_PER_MESSAGE=5

# ─────────────────────────────────────────────────────────────────
# FurnitureCRM — forward-looking vars (filled in their respective phases)
# ─────────────────────────────────────────────────────────────────

# File storage abstraction (Step 4.7)
STORAGE_BACKEND=local
STORAGE_ROOT=./storage

# WhatsApp Business Cloud API — Conversations (Step 3.9)
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# AI / LLM — Conversations chatbot + auto follow-ups (Step 5.7, 5.8)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# Marketplace integrations (Steps 5.2 / 5.3 / 5.4)
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
FLIPKART_CLIENT_ID=
FLIPKART_CLIENT_SECRET=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# AI Virtual Staging — Replicate / Stability (Step 5.9)
STAGING_PROVIDER=replicate
REPLICATE_API_TOKEN=

# ─────────────────────────────────────────────────────────────────
# Ad integrations (Google Ads + Meta Ads) — Track 4
# ─────────────────────────────────────────────────────────────────

# Fernet key for at-rest encryption of stored OAuth tokens.
# Generate with:
#   docker exec template_api-api-1 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED — `core/integrations/*` refuses to import without it.
# Losing the key = every org must reconnect Google + Meta.
INTEGRATIONS_ENCRYPTION_KEY=

# Google Ads OAuth (Track 4 Step 2)
# Provision from Google Cloud Console — see
# tasks/ad-integrations/manual-google-oauth-setup.md
# Test users bypass verification; the code works in dev without
# the verification process being complete.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
# Developer Token — separate from OAuth, attached to a Google Ads
# Manager (MCC) account. 1-5 day approval. See Stage 4 of the checklist.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Google Ads REST API version pin. Bumping is a separate small task.
GOOGLE_ADS_API_VERSION=v17



