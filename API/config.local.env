# ─────────────────────────────────────────────────────────────────
# LOCAL non-secret configuration. Loaded on top of config.env when
# .environment == local. Secrets live in secrets.local.enc.env
# (SOPS-encrypted, injected at runtime by run.cmd / run.sh).
#
# All values here are safe to commit — real secrets never live in
# any config.*.env file.
# ─────────────────────────────────────────────────────────────────

APP_ENV=local
IS_DEVELOPMENT=true

# File storage (tasks/r2-storage) — local dev stores blobs in the private
# `crm-local` R2 bucket (Cloudflare account dev@karmcrm.com). Only ONE developer
# machine should point here: seeded databases share org/row UUIDs, so two
# machines would overwrite and orphan-sweep each other's files. Everyone else
# sets STORAGE_BACKEND=local. R2_* credentials live in secrets.local.enc.env.
STORAGE_BACKEND=r2

# No reverse proxy locally, so trust no forwarded headers.
TRUSTED_PROXIES=

# Database — points at the local Postgres container defined in
# docker-compose.local.yml. "db" is the compose service name; Docker's
# built-in DNS resolves it to the container. The container's internal
# port is always 5432; the host-published port (DB_HOST_PORT below) is
# only used for DBeaver / psql from your machine.
DB_HOST=db
DB_PORT=5432

# Host port the local Postgres container publishes on, for DBeaver / psql
# from your machine. NOT used by the app — inside the compose network the
# API reaches Postgres at db:5432 above.
#
# Published host ports are machine-wide, not per-project, so this must be
# unique across EVERY compose stack you run locally. 5432 is a native
# Postgres install; 5434 and 5435 are taken by sibling projects on this
# machine. Symptom of a clash is `run.cmd upgrade` failing with
# "Bind for 127.0.0.1:<port> failed: port is already allocated".
# Find the culprit with: docker ps --format "{{.Names}}	{{.Ports}}"
DB_HOST_PORT=5437
DB_NAME=crm_local
DB_USER=postgres

# Frontend / API base URLs — localhost only.
FRONTEND_URL=http://localhost:4207
API_BASE_URL=http://localhost:30007

# OAuth callbacks — must match "Authorized redirect URIs" registered on
# each provider's console. Both localhost and prod URLs are registered
# on the shared OAuth clients so devs can flip envs without dashboard changes.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:30007/api/v1/integrations/google/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:30007/api/v1/email/gmail/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:30007/api/v1/integrations/google-calendar/callback
META_OAUTH_REDIRECT_URI=http://localhost:30007/api/v1/integrations/meta/callback
MICROSOFT_GRAPH_REDIRECT_URI=http://localhost:30007/api/v1/integrations/microsoft/callback

# Mailgun inbound — dev sandbox domain / ngrok tunnel. Leave empty if
# you're not testing inbound email locally; the code fails soft.
# Mailgun is a public service, so it cannot POST to localhost; use an
# ngrok / cloudflared tunnel URL when you actually want to receive
# inbound email during dev.
MAILGUN_DOMAIN=devreply.karmcrm.com
INBOUND_EMAIL_DOMAIN=devreply.karmcrm.com
MAILGUN_WEBHOOK_URL=https://cleo-fagaceous-tien.ngrok-free.dev/api/v1/webhooks/mailgun/inbound

# tasks/email-sending-domains Step 6 — DNS-drift state-machine
# thresholds for tbl_organization_email_domains. The nightly sweep
# demotes a verified domain once ``consecutive_failed_checks`` crosses
# ``EMAIL_DOMAIN_DEMOTE_AFTER_FAILED_CHECKS``; the hourly sweep auto-
# releases rows stuck in demoted longer than
# ``EMAIL_DOMAIN_RELEASE_AFTER_FAILED_DAYS``. Both defaults match the
# manager spec; override per-env only if a customer needs a tighter
# / looser cadence.
EMAIL_DOMAIN_DEMOTE_AFTER_FAILED_CHECKS=3
EMAIL_DOMAIN_RELEASE_AFTER_FAILED_DAYS=14

# Microsoft Graph subscription webhook — same story as Mailgun: MS
# push notifications need a public HTTPS URL, so localhost won't work.
# Leave empty in local (sync falls back to the 60-second poll), or
# paste an ngrok URL like
# `https://<sub>.ngrok-free.dev/api/v1/email/microsoft/webhook`
# when you want to test push notifications from your machine.
MICROSOFT_GRAPH_WEBHOOK_URL=

# ── Local developer login ────────────────────────────────────────
# Seeded by `run.cmd seed` (src/app/scripts/seed_dev_user.py) so a
# rebuilt local database is usable without registering through the UI.
# `run.cmd down` drops the db volume and `run.cmd restart` is down+up,
# so this happens more often than you would like.
#
# The seed runs the real signup path, so this account gets a full org
# with the Owner role template and the base pack (Leads pipeline +
# stages, lead sources, call outcomes) — not a hand-inserted row.
#
# The PASSWORD is deliberately not here. It lives in
# secrets.local.enc.env (SOPS-encrypted) as DEV_SEED_PASSWORD, because
# config.*.env files are committed in plaintext. Change it with:
#     run.cmd secrets-edit local
#
# Clearing DEV_SEED_EMAIL disables the seed.
DEV_SEED_EMAIL=pandeyabhishek234@gmail.com
DEV_SEED_FIRST_NAME=Abhishek
DEV_SEED_LAST_NAME=Pandey
# Optional. Empty = the signup default, "<first name>'s Workspace".
DEV_SEED_ORG_NAME=

# Meta App — CRM's central Meta app. Used for local dev, testing, and
# the future Embedded Signup flow (customers connect their WABA under
# this app; their inbound webhooks then get signed by this app's
# secret, which is stored as WHATSAPP_APP_SECRET in secrets.local.enc.env).
META_APP_ID=1669292607950044

# WhatsApp Embedded Signup — Facebook Login for Business configuration
# ("CRM WhatsApp Signup") on the Meta App above. Config IDs are per-App,
# so each env file carries its own.
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=1909352576709291
# Embedded Signup v4 popup + WhatsApp Graph calls — matches the Meta App dashboard version.
WHATSAPP_GRAPH_API_VERSION=v26.0

# Sentry — disabled for local dev. SENTRY_DSN is set only in the prod
# overlays (config.prod-neuradigi.env, config.prod.env); with no DSN the
# SDK init in main.py / celery worker is skipped entirely.
