# ─────────────────────────────────────────────────────────────────
# LOCAL non-secret configuration. Loaded on top of config.env when
# .environment == local. Secrets live in secrets.local.enc.env
# (SOPS-encrypted, injected at runtime by run.cmd / run.sh).
#
# All values here are safe to commit — real secrets never live in
# any config.*.env file.
# ─────────────────────────────────────────────────────────────────

APP_ENV=local
IS_DEVELOPMENT=true

# Database — points at the local Postgres container defined in
# docker-compose.local.yml. "db" is the compose service name; Docker's
# built-in DNS resolves it to the container. The container's internal
# port is always 5432; the host-published port (127.0.0.1:5434) is only
# used for DBeaver / psql from your machine.
DB_HOST=db
DB_PORT=5432
DB_NAME=crm_local
DB_USER=postgres

# Frontend / API base URLs — localhost only.
FRONTEND_URL=http://localhost:4200
API_BASE_URL=http://localhost:30007

# OAuth callbacks — must match "Authorized redirect URIs" registered on
# each provider's console. Both localhost and prod URLs are registered
# on the shared OAuth clients so devs can flip envs without dashboard changes.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:30007/api/v1/integrations/google/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:30007/api/v1/email/gmail/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:30007/api/v1/integrations/google-calendar/callback
META_OAUTH_REDIRECT_URI=http://localhost:30007/api/v1/integrations/meta/callback
MICROSOFT_GRAPH_REDIRECT_URI=http://localhost:30007/api/v1/integrations/microsoft/callback

# Mailgun inbound — dev sandbox domain / ngrok tunnel. Leave empty if
# you're not testing inbound email locally; the code fails soft.
MAILGUN_DOMAIN=
INBOUND_EMAIL_DOMAIN=
MAILGUN_WEBHOOK_URL=
