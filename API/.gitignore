# SOPS + age — never commit private keys or decrypted secret dumps.
# (config.env, config.*.env and secrets.*.enc.env ARE committed — do NOT ignore them.)
*.agekey
age-key*.txt
keys.txt
*.dec.env
secrets.dec.env

# Per-machine environment marker (one word: "local" or "prod"). Not committed —
# every checkout picks its own env. `run.cmd` / `run.sh` refuse to start
# without it, so a missing marker is a hard error, not a silent default.
.environment

# Celery stuff
celerybeat-schedule*
celerybeat.pid

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# IDE
.idea/
.vscode/

# Project-specific
static/images/uploads/*

# Generated at API startup by src/providers/route_provider.py from the routes
# table, and served by GET /api/routes/config. Tracking it meant a committed
# empty {} shadowed the real thing on a fresh clone, and the file churned on
# every boot. It is regenerated on startup, so it never needs to be in git.
data/routes.json
