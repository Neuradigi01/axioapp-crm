{
  "version": "5.0",
  "data_api_version": "3.0",
  "routing_model": {
    "BOOK": []
  },
  "screens": [
    {
      "id": "BOOK",
      "title": "Book an appointment",
      "terminal": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Pick a date and time"
          },
          {
            "type": "Form",
            "name": "booking_form",
            "children": [
              {
                "type": "TextInput",
                "name": "full_name",
                "label": "Your name",
                "required": true,
                "input-type": "text",
                "helper-text": "How should we address you?"
              },
              {
                "type": "DatePicker",
                "name": "preferred_date",
                "label": "Preferred date",
                "required": true,
                "helper-text": "Pick any date in the next 60 days."
              },
              {
                "type": "Dropdown",
                "name": "preferred_time",
                "label": "Preferred time",
                "required": true,
                "data-source": [
                  {"id": "10:00", "title": "10:00 AM"},
                  {"id": "11:00", "title": "11:00 AM"},
                  {"id": "12:00", "title": "12:00 PM"},
                  {"id": "14:00", "title": "2:00 PM"},
                  {"id": "15:00", "title": "3:00 PM"},
                  {"id": "16:00", "title": "4:00 PM"},
                  {"id": "17:00", "title": "5:00 PM"}
                ]
              },
              {
                "type": "Dropdown",
                "name": "service",
                "label": "What would you like to book?",
                "required": true,
                "data-source": [
                  {"id": "consultation", "title": "Consultation"},
                  {"id": "design_review", "title": "Design review"},
                  {"id": "in_store_visit", "title": "In-store visit"},
                  {"id": "delivery_followup", "title": "Delivery follow-up"}
                ]
              },
              {
                "type": "TextArea",
                "name": "notes",
                "label": "Anything we should know? (optional)",
                "required": false,
                "max-length": 500
              },
              {
                "type": "Footer",
                "label": "Book appointment",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "full_name": "${form.full_name}",
                    "preferred_date": "${form.preferred_date}",
                    "preferred_time": "${form.preferred_time}",
                    "service": "${form.service}",
                    "notes": "${form.notes}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
