# ─────────────────────────────────────────────────────────────────
# Non-secret configuration — committed in plaintext.
#
# Secrets are NOT here. They live in secrets.enc.env (SOPS + age
# encrypted) and are injected into the process environment at runtime
# by `sops exec-env` (see run.cmd / run.sh), then read via os.getenv.
# There is no plaintext secrets file on disk.
#
# Environment-specific values (IS_DEVELOPMENT, DB_NULL_POOL) live in
# the compose overlays (docker-compose.dev.yml / docker-compose.prod.yml),
# not here — this file is shared by every environment.
# ─────────────────────────────────────────────────────────────────

# Project
COMPOSE_PROJECT_NAME=crm
APP_NAME=CRM

# Docker Compose
API_PORT=30007
LISTEN_ADDR=127.0.0.1
FLOWER_PORT=5557
FLOWER_USER=DevAdmin

# Captcha — "none" | "image" | "recaptcha_v2" | "recaptcha_v3"
# (RECAPTCHA_SECRET_KEY is a secret — see secrets.enc.env)
CAPTCHA_TYPE=recaptcha_v3
RECAPTCHA_SITE_KEY=6LdhkqMqAAAAAHHJPzaTa0ZJzPms2ugFoMaHn6bj

# Database
# (DB_PASSWORD is a secret — see secrets.enc.env)
DB_HOST=145.223.21.204
DB_PORT=8975
DB_NAME=db_crm_template
DB_USER=postgres

# JWT & Security
# (JWT_SECRET_KEY and FERNET_KEY are secrets — see secrets.enc.env)
JWT_ALGORITHM=HS256

# OTP
OTP_EXPIRY_MINUTES=10

# Email (SMTP)
# (EMAIL_PASSWORD and EMAIL_APP_PASSWORD are secrets — see secrets.enc.env)
EMAIL_ENABLED=true
EMAIL_SENDER=contact@neuradigi.com
EMAIL_USER=77462f002@smtp-brevo.com
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587

# HMAC signing key for open/click tracking pixel + redirect URLs.
# 64 hex chars = 256-bit secret. Rotating this invalidates every
# already-embedded tracking link — regenerate only if compromised.
# For prod, move to secrets.enc.env via `run secrets-edit`.
TRACKING_HMAC_KEY=8b7fff86ea4fa7ddb1872cc987b98d114bb1857dc209cf1e53c50e55b8a5dab9

# Contact Verification — "none" | "pre" | "post"
CONTACT_VERIFICATION_MODE=post

# SMS
# (SMS_API_KEY is a secret — see secrets.enc.env)
SMS_ENABLED=false
SMS_API_URL=https://api.sms-provider.com/send

# Redis / Celery
# (REDIS_PASSWORD is a secret — see secrets.enc.env)
CELERY_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB_BROKER=0
REDIS_DB_RESULT=1
REDIS_DB_PUBSUB=2
REDIS_DB_CACHE=3

# Push Notifications (Firebase)
# (FIREBASE_PRIVATE_KEY, FIREBASE_API_KEY, FIREBASE_VAPID_KEY are secrets — see secrets.enc.env)
PUSH_NOTIFICATION_ENABLED=true
FIREBASE_PROJECT_ID=my-project-e5349
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-p443y@my-project-e5349.iam.gserviceaccount.com
FIREBASE_AUTH_DOMAIN=my-project-e5349.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=820554967883
FIREBASE_APP_ID=1:820554967883:web:a7b84bb270e416b54ad6ce

# Frontend / API base URLs
FRONTEND_URL=https://crm.neuradigi.com
API_BASE_URL=https://crm-api.neuradigi.com

# Time
DATETIME_FORMAT=%d-%b-%Y %I:%M:%S %p
TIMEZONE=Asia/Kolkata

# Static / Uploads
STATIC_DIR=./static
MAX_FILE_SIZE_MB=10
MAX_ATTACHMENTS_PER_MESSAGE=5

# File storage abstraction
STORAGE_BACKEND=local
STORAGE_ROOT=./storage

# WhatsApp Business Cloud API
# (WHATSAPP_APP_SECRET is a secret — add to secrets.enc.env when used)
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_GRAPH_API_VERSION=v19.0

# WhatsApp Web (unofficial / Baileys) sidecar — Step 4 of the
# tasks/whatsapp-unofficial track. The sidecar lives at
# sidecars/whatsapp-web/ and speaks HTTP+HMAC.
# WHATSAPP_WEB_SIDECAR_HMAC_SECRET (outbound) and
# WHATSAPP_WEB_INBOUND_HMAC_SECRET (inbound from sidecar) are secrets —
# add them via `run secrets-edit`, NOT here.
WHATSAPP_WEB_SIDECAR_URL=http://whatsapp-web-sidecar:4000

# AI / LLM — Conversations chatbot + auto follow-ups
# (ANTHROPIC_API_KEY is a secret — add to secrets.enc.env when used)
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-6

# AI Assistants — BYOK provider-key store (tasks/ai-assistants Step 1).
# AI_PROVIDER_KEY_KEK is a SECRET — 32-byte base64-url-safe encoded
# AES-GCM key. Add via `run secrets-edit`, NOT here. MUST be distinct
# from INTEGRATIONS_ENCRYPTION_KEY / FERNET_KEY / JWT_SECRET_KEY (a
# startup pin-test refuses to boot if any two match).
# Generate with:
#   python -c "import secrets, base64; \
#     print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"

# tasks/ai-assistants-omnichannel Step 6 — gate for the AI email
# inbound path. When enabled, ``dispatch.route_email_inbound`` runs
# the reply-worthiness guardrail on every persisted inbound email and
# (once the ChannelContext refactor lands in a follow-up step)
# invokes the AI reply pipeline. Kept OFF by default so orgs upgrading
# without a bound email assistant see zero behaviour change; ops flip
# to ``true`` per environment.
AI_EMAIL_INBOUND_ENABLED=false

# Google Ads OAuth
# (GOOGLE_OAUTH_CLIENT_SECRET, GOOGLE_ADS_DEVELOPER_TOKEN are secrets — see secrets.enc.env)
GOOGLE_OAUTH_CLIENT_ID=514056479792-l91ehgsbm7cojk9444fmrm44dekqsvka.apps.googleusercontent.com
GOOGLE_OAUTH_REDIRECT_URI=https://crm-api.neuradigi.com/api/v1/integrations/google/callback
GOOGLE_ADS_LOGIN_CUSTOMER_ID=9214634784
GOOGLE_ADS_API_VERSION=v21

# Gmail + Google Calendar OAuth callbacks — must be an exact match against
# an "Authorized redirect URI" registered on the same OAuth client in
# Google Cloud Console (Credentials → OAuth 2.0 Client). Both the live
# and the localhost URLs are registered there so a developer can flip
# these locally without dashboard changes.
GOOGLE_GMAIL_REDIRECT_URI=https://crm-api.neuradigi.com/api/v1/email/gmail/callback
GOOGLE_CALENDAR_REDIRECT_URI=https://crm-api.neuradigi.com/api/v1/integrations/google-calendar/callback

# Meta (Facebook + Instagram) Ads OAuth
# (META_APP_SECRET, META_WEBHOOK_VERIFY_TOKEN are secrets — see secrets.enc.env)
META_APP_ID=1514812010052291
META_OAUTH_REDIRECT_URI=https://crm-api.neuradigi.com/api/v1/integrations/meta/callback
META_GRAPH_API_VERSION=v19.0

# Microsoft Graph OAuth (Outlook / Microsoft 365 email sender)
# (MICROSOFT_GRAPH_CLIENT_SECRET is a secret — see secrets.enc.env)
# TENANT_ID=common → multi-tenant (any Entra ID + personal MS accounts).
# Do NOT set to a specific tenant GUID — that locks connect to one org.
MICROSOFT_GRAPH_CLIENT_ID=270fcd56-9908-4359-ac08-2e487e56002e
MICROSOFT_GRAPH_TENANT_ID=common
MICROSOFT_GRAPH_REDIRECT_URI=http://localhost:30007/api/v1/integrations/microsoft/callback

# Stripe
# (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET are secrets — see secrets.enc.env)
STRIPE_PUBLISHABLE_KEY=pk_test_51Tg1FPBR2LaczJ5CRpBImkgys1QGE9aQFc1pYOK7KH3KiZMRgPwW949V6yCFrCIWGt6pGjKHSDB6Aua6cGltEFu100U5O32Fp3

# Mailgun inbound receiving (mailgun-inbound track)
# ─────────────────────────────────────────────────
# (MAILGUN_API_KEY, MAILGUN_SIGNING_KEY are secrets — see secrets.enc.env.
#  MAILGUN_SIGNING_KEY_PREVIOUS is also a secret; leave empty except during
#  key rotation.)
#
# MAILGUN_DOMAIN — the Mailgun-side receiving domain. In dev this is the
# auto-provisioned sandbox subdomain; in prod flip to `reply.neuradigi.com`
# once DNS is verified (Step 8 cutover).
#
# INBOUND_EMAIL_DOMAIN — appended to outbound `Reply-To` headers as
# `in_<token>@<domain>`. Same value as MAILGUN_DOMAIN today; split so a
# future custom-domain feature can diverge them per org.
#
# MAILGUN_WEBHOOK_URL — full HTTPS URL the Mailgun Route posts each
# inbound email to. Used by `scripts/mailgun_route_setup.py` to configure
# the route.
MAILGUN_DOMAIN=sandbox3f4add564a974bc6a2c07ebf6d1fad9a.mailgun.org
INBOUND_EMAIL_DOMAIN=sandbox3f4add564a974bc6a2c07ebf6d1fad9a.mailgun.org
MAILGUN_WEBHOOK_URL=https://crm-api.neuradigi.com/api/v1/webhooks/mailgun/inbound
